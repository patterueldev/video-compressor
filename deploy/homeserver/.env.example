# Copy to .env (gitignored) and fill in. Never commit real values.
# VC_WORKER_TOKEN is the controller bearer token: run `vc controller --print-token`
# on the controller machine and paste it here. Empty values fail compose fast.
VC_WORKER_TOKEN=
# Host path of the archive root on this machine (container path: /srv/archive, rw).
VC_ARCHIVE_ROOT=/mnt/archive-drive
# Host path for scratch on the internal disk (container path: /var/lib/videocompressor/scratch).
VC_SCRATCH_ROOT=/srv/videocompressor/scratch
# uid/gid that owns the archive files on this machine (id -u / id -g).
VC_UID=1000
VC_GID=1000
